// Drools-style rule: metadata + single when block (Spark apply_drl evaluates one rule per broadcast).
// Salience / agenda / activation / reason_codes / stop_on_fire are parsed and carried on the AST;
// cross-rule ordering uses the chain simulator or /simulations/chain — not this single-rule Spark path.

rule CampaignEliteOffer
salience 100
agenda_group "pricing"
activation_group "campaign_2024"
reason_codes [ "RETAIL", "HIGH_VALUE", "SPARK_DEMO" ]
stop_on_fire true
when
$t : Tx (
    $t.amount >= 400
    and $t.risk_score <= 75
    and ( $t.region == "US" or $t.region == "EU" )
    and $t.segment == "retail"
)
then
result.tier = "ELITE";
result.discount_pct = 15;
result.campaign_id = "CMP-2024-Q1";
end
