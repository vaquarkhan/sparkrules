// Shared ingress rules for streaming examples — fact JSON maps to $t : T.

rule "high_amount_hold"
  salience 100
  when
    $t : T( $t.amount > 10000 )
  then
    result.status = "hold";
    result.reason = "AMT_HIGH";
end

rule "default_ok"
  salience 0
  when
    $t : T( true )
  then
    result.status = "ok";
end
